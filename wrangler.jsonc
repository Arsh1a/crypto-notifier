{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crypto-notifier",
  // The OAuth token can see more than one account, so pin the target explicitly.
  "account_id": "83179c771ceb45d122d415e4a59fd925",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
